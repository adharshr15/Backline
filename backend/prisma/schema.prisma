// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}


enum Role {
  USER
  ADMIN
}

enum AccountType {
  USER
  BAND
  VENUE
}

enum BandRole {
  MANAGER
  MEMBER
}

enum VenueRole {
  MANAGER
  REPRESENTATIVE
}

enum ShowStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ShowRole {
  HEADLINER
  SUPPORT
}

enum ParticipantType {
  USER
  BAND
  VENUE
}

enum ConversationType {
  USER_USER
  USER_BAND
  USER_VENUE
  BAND_BAND
  BAND_VENUE
  VENUE_VENUE
}

/// The trades a user practices in a scene. Replaces the dead User.isPromoter
/// boolean. API inputs are validated against Object.values(Craft) -- never free text.
enum Craft {
  PHOTOGRAPHER
  VIDEOGRAPHER
  PROMOTER
  SOUND_ENGINEER
  BOOKER
  TOUR_MANAGER
  STAGE_MANAGER
  LIGHTING_TECH
  DESIGNER
  MERCH
  JOURNALIST
  DJ
  LUTHIER
  INSTRUCTOR
}

model User {
  id                String                    @id @default(cuid())
  username          String                    @unique
  name              String
  email             String                    @unique
  password          String
  accountType       AccountType
  bio               String?
  city              String?
  state             String?
  country           String?
  profileImageUrl   String?
  headerImageUrl    String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  bandMemberships   BandMember[]
  venueReps         VenueRepresentative[]
  following         Follow[]                  @relation("UserFollowing")
  followers         Follow[]                  @relation("UserFollowers")
  conversations     ConversationParticipant[]
  sentMessages      Message[]                 @relation("UserMessages")
  sentConversationInvites                     ConversationInvite[]          @relation("ConversationInviteSenderUser")
  receivedConversationInvites                 ConversationInvite[]          @relation("ConversationInviteRecipientUser")
  bandInvites       BandInvite[]
  venueInvites      VenueInvite[]
  showsCreated      Show[]                    @relation("showCreatedByUser")
  showsReposted     Show[]                    @relation("showRepostedByUser")
  showsRsvp         Show[]                    @relation("showRsvpByUser")
  listings          Listing[]                 @relation("UserListings")
  posts             Post[]                    @relation("UserPosts")
  postComments      PostComment[]             @relation("UserPostComments")
  crafts            UserCraft[]

  /// Always reflects the row's current city/state. Nullable only because the
  /// backfill runs after this column exists, and because city/state are optional.
  sceneId           String?
  scene             Scene?                    @relation(fields: [sceneId], references: [id])

  @@index([city, state])
  @@index([sceneId])
}

model Band {
  id                String                    @id @default(cuid())
  name              String
  city              String?
  state             String?
  country           String?
  profileImageUrl   String?
  headerImageUrl    String?
  bio               String?
  accountType       AccountType
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  members           BandMember[]
  shows             ShowBand[]
  showsCreated      Show[]                    @relation("showCreatedByBand")
  toursCreated      Tour[]                    @relation("tourCreatedByBand")
  showsReposted     Show[]                    @relation("showRepostedByBand")
  showsRsvp         Show[]                    @relation("showRsvpByBand")
  tours             BandTour[]
  invites           BandInvite[]
  showInvites       ShowInvite[]
  tourInvites       TourInvite[]
  conversations     ConversationParticipant[]
  sentMessages      Message[]                 @relation("BandMessages")
  sentConversationInvites                     ConversationInvite[]        @relation("ConversationInviteSenderBand")
  receivedConversationInvites                 ConversationInvite[]        @relation("ConversationInviteRecipientBand")
  following         Follow[]                  @relation("BandFollowing")
  followers         Follow[]                  @relation("BandFollowers")
  listings          Listing[]                 @relation("BandListings")
  posts             Post[]                    @relation("BandPosts")
  postComments      PostComment[]             @relation("BandPostComments")
  genres            BandGenre[]

  sceneId           String?
  scene             Scene?                    @relation(fields: [sceneId], references: [id])

  @@index([city, state])
  @@index([sceneId])
}

model BandMember {
  id                String                    @id @default(cuid())
  user              User                      @relation(fields: [userId], references: [id])
  userId            String                    
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  role              BandRole                  @default(MEMBER)
  
  @@unique([userId, bandId])
  @@index([bandId])
  @@index([userId])
}

model BandTour {
  id                String                    @id @default(cuid())

  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String 
  tour              Tour                      @relation(fields: [tourId], references: [id])
  tourId            String

  @@unique([bandId, tourId])
}

model BandInvite {
  id                String                    @id @default(cuid())
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  user              User                      @relation(fields: [userId], references: [id])
  userId            String
  status            InviteStatus              @default(PENDING)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([bandId, userId])
}

model Venue {
  id                String                    @id @default(cuid())
  name              String
  city              String 
  state             String
  country           String
  latitude          Float?
  longitude         Float?
  address           String?
  capacity          Int?
  accountType       AccountType
  contactEmail      String?
  profileImageUrl   String?
  headerImageUrl    String?
  bio               String?
  representatives   VenueRepresentative[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  shows             Show[]   
  showsCreated      Show[]                    @relation("showCreatedByVenue")
  showsReposted     Show[]                    @relation("showRepostedByVenue")
  showsRsvp         Show[]                    @relation("showRsvpByVenue")
  showInvites       ShowInvite[]
  blocks            VenueBlock[]   
  invites           VenueInvite[]
  conversations     ConversationParticipant[]
  sentMessages      Message[]                 @relation("VenueMessages")
  sentConversationInvites                     ConversationInvite[]          @relation("ConversationInviteSenderVenue")
  receivedConversationInvites                 ConversationInvite[]          @relation("ConversationInviteRecipientVenue")
  following         Follow[]                  @relation("VenueFollowing")
  followers         Follow[]                  @relation("VenueFollowers")
  listings          Listing[]                 @relation("VenueListings")
  posts             Post[]                    @relation("VenuePosts")
  postComments      PostComment[]             @relation("VenuePostComments")

  sceneId           String?
  scene             Scene?                    @relation(fields: [sceneId], references: [id])

  @@index([city])
  @@index([city, state])
  @@index([capacity])
  @@index([latitude, longitude])
  @@index([sceneId])
}

model VenueRepresentative {
  id                String                    @id @default(cuid())
  user              User                      @relation(fields: [userId], references: [id])
  userId            String                    
  venue             Venue                     @relation(fields: [venueId], references: [id])
  venueId           String
  role              VenueRole                 @default(REPRESENTATIVE)
  
  @@unique([userId, venueId])
  @@index([venueId])
  @@index([userId])
}

model VenueInvite {
  id                String                    @id @default(cuid())
  venue             Venue                     @relation(fields: [venueId], references: [id])
  venueId           String
  user              User                      @relation(fields: [userId], references: [id])
  userId            String
  status            InviteStatus              @default(PENDING)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  
  @@index([venueId, userId])
}

model Tour {
  id                String                    @id @default(cuid())
  name              String                    
  startDate         DateTime?
  endDate           DateTime?
  
  bands             BandTour[]
  shows             Show[]

  tourInvites       TourInvite[]

  createdByBandId   String?
  createdByBand     Band?                     @relation("tourCreatedByBand", fields: [createdByBandId], references: [id])

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
}

model TourInvite {
  id                String                    @id @default(cuid())
  tourId            String
  bandId            String
  status            InviteStatus              @default(PENDING)

  tour              Tour                      @relation(fields: [tourId], references: [id])
  band              Band                      @relation(fields: [bandId], references: [id])

  createdAt         DateTime                  @default(now())

  @@index([tourId, bandId])
}

model Show {
  id                String                    @id @default(cuid())
  date              DateTime
  city              String
  state             String
  country           String
  status            ShowStatus                @default(PENDING)
  doors             DateTime
  posterUrl         String?     
  ticketsUrl        String?      
  notes             String?

  tour              Tour?                     @relation(fields: [tourId], references: [id])
  tourId            String?

  venue             Venue?                    @relation(fields: [venueId], references: [id])
  venueId           String?

  venueName         String?
  venueAddress      String?
  bandLineup        String?

  bands             ShowBand[]
  showInvites       ShowInvite[]
  posts             Post[]

  repostedByUsers   User[]                    @relation("showRepostedByUser")
  repostedByBands   Band[]                    @relation("showRepostedByBand")
  repostedByVenues  Venue[]                   @relation("showRepostedByVenue")

  rsvpUsers         User[]                    @relation("showRsvpByUser")
  rsvpBands         Band[]                    @relation("showRsvpByBand")
  rsvpVenues        Venue[]                   @relation("showRsvpByVenue")

  createdByBandId   String?
  createdByBand     Band?                     @relation("showCreatedByBand", fields: [createdByBandId], references: [id])

  createdByUserId   String?
  createdByUser     User?                     @relation("showCreatedByUser", fields: [createdByUserId], references: [id])

  createdByVenueId  String?
  createdByVenue    Venue?                    @relation("showCreatedByVenue", fields: [createdByVenueId], references: [id])

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  /// Set from the show's own city/state, not derived through the venue --
  /// Show.venueId is nullable, and deriving would silently drop every DIY show.
  sceneId           String?
  scene             Scene?                    @relation(fields: [sceneId], references: [id])

  @@index([tourId])
  @@index([venueId])
  @@index([city])
  @@index([city, state, date])
  @@index([date])
  @@index([status])
  @@index([sceneId, date])
}

model VenueBlock {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])

  startTime DateTime
  endTime   DateTime
  reason    String?
}

enum MediaType {
  PHOTO
  VIDEO
}

model ShowBand {
  id                String                    @id @default(cuid())
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  show              Show                      @relation(fields: [showId], references: [id])
  showId            String
  role              ShowRole?

  @@unique([bandId, showId])
  @@index([showId])
}

model ShowInvite {
  id                String                    @id @default(cuid())
  showId            String
  bandId            String?
  venueId           String?
  status            InviteStatus              @default(PENDING)

  show              Show                      @relation(fields: [showId], references: [id])
  band              Band?                     @relation(fields: [bandId], references: [id])
  venue             Venue?                    @relation(fields: [venueId], references: [id])

  createdAt         DateTime                  @default(now())

  @@index([showId, bandId, venueId])
}

model Conversation {
  id                String                    @id @default(cuid())
  name              String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  participants      ConversationParticipant[]
  messages          Message[]
  invites           ConversationInvite[]
}

model ConversationParticipant {
  id                String                    @id @default(cuid())
  conversation      Conversation              @relation(fields: [conversationId], references: [id])
  conversationId    String

  participantType   ParticipantType

  user              User?                     @relation(fields: [userId], references: [id])
  userId            String?

  band              Band?                     @relation(fields: [bandId], references: [id])
  bandId            String?

  venue             Venue?                    @relation(fields: [venueId], references: [id])
  venueId           String?

  joinedAt          DateTime                  @default(now())
  lastReadAt        DateTime                  @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([bandId])
  @@index([venueId])
  @@unique([conversationId, userId])
  @@unique([conversationId, bandId])
  @@unique([conversationId, venueId])
}

model ConversationInvite {
  id                String                    @id @default(cuid())
  createdAt         DateTime                  @default(now())
  status            InviteStatus              @default(PENDING)

  message           String?

  senderUserId      String?
  senderUser        User?                     @relation("ConversationInviteSenderUser", fields: [senderUserId], references: [id])

  senderBandId      String?
  senderBand        Band?                     @relation("ConversationInviteSenderBand", fields: [senderBandId], references: [id])

  senderVenueId     String?
  senderVenue       Venue?                    @relation("ConversationInviteSenderVenue", fields: [senderVenueId], references: [id])

  recipientUserId   String?
  recipientUser     User?                     @relation("ConversationInviteRecipientUser", fields: [recipientUserId], references: [id])

  recipientBandId   String?
  recipientBand     Band?                     @relation("ConversationInviteRecipientBand", fields: [recipientBandId], references: [id])

  recipientVenueId  String?
  recipientVenue    Venue?                    @relation("ConversationInviteRecipientVenue", fields: [recipientVenueId], references: [id])

  conversationId    String?
  conversation      Conversation?             @relation(fields: [conversationId], references: [id])

  @@index([senderUserId])
  @@index([senderBandId])
  @@index([senderVenueId])
  @@index([recipientUserId])
  @@index([recipientBandId])
  @@index([recipientVenueId])
}

model Message {
  id              String                      @id @default(cuid())
  content         String
  isSystemMessage Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  deletedAt       DateTime?

  conversation    Conversation                @relation(fields: [conversationId], references: [id])
  conversationId  String

  senderUser      User?                       @relation("UserMessages", fields: [senderUserId], references: [id])
  senderUserId    String?

  senderBand      Band?                       @relation("BandMessages", fields: [senderBandId], references: [id])
  senderBandId    String?

  senderVenue     Venue?                      @relation("VenueMessages", fields: [senderVenueId], references: [id])
  senderVenueId   String?

  // Optional image attachment (relative /uploads path).
  imageUrl        String?

  // Optional attachment: an entity previewed inline in the message.
  // One nullable FK per attachable kind (same idiom as the sender FKs above).
  listing         Listing?                    @relation("ListingMessages", fields: [listingId], references: [id])
  listingId       String?
  // showId / show ← add here in the shows follow-up

  @@index([conversationId])
  @@index([createdAt])
}

model Follow {
  id               String      @id @default(cuid())

  followerUserId   String?
  followerBandId   String?
  followerVenueId  String?
  followerType     AccountType

  followeeUserId   String?
  followeeBandId   String?
  followeeVenueId  String?
  followeeType     AccountType

  followerUser     User?   @relation("UserFollowing",  fields: [followerUserId],  references: [id])
  followerBand     Band?   @relation("BandFollowing",  fields: [followerBandId],  references: [id])
  followerVenue    Venue?  @relation("VenueFollowing", fields: [followerVenueId], references: [id])
  followeeUser     User?   @relation("UserFollowers",  fields: [followeeUserId],  references: [id])
  followeeBand     Band?   @relation("BandFollowers",  fields: [followeeBandId],  references: [id])
  followeeVenue    Venue?  @relation("VenueFollowers", fields: [followeeVenueId], references: [id])

  createdAt        DateTime @default(now())

  @@index([followerUserId])
  @@index([followerBandId])
  @@index([followerVenueId])
  @@index([followeeUserId])
  @@index([followeeBandId])
  @@index([followeeVenueId])
}

model SceneFollow {
  id           String   @id @default(cuid())
  followerId   String
  followerType String
  createdAt    DateTime @default(now())

  sceneId      String
  scene        Scene    @relation(fields: [sceneId], references: [id])


  @@unique([followerId, followerType, sceneId])
  @@index([followerId, followerType])
  @@index([sceneId])
}

/// A local music community, keyed by city. Backfilled from the cities that
/// already have venues, shows, bands or users, and created on demand when a
/// profile is saved in a city that has no scene yet.
///
/// Sub-scenes ("Houston Shoegaze") are a (sceneId, genreId) query, never rows --
/// materializing them would mean touching scene rows whenever a band's genre changes.
model Scene {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  city           String
  state          String
  country        String    @default("USA")
  latitude       Float?
  longitude      Float?
  bio            String?
  imageUrl       String?
  headerImageUrl String?
  isCurated      Boolean   @default(false)

  /// Reserved for a future hierarchy ("Greater Houston", or merging katy-tx into
  /// houston-tx). Null for every row today.
  parentId       String?
  parent         Scene?    @relation("SceneParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children       Scene[]   @relation("SceneParent")

  follows        SceneFollow[]
  shows          Show[]
  bands          Band[]
  venues         Venue[]
  users          User[]
  posts          Post[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([city, state])
  @@index([state])
  @@index([latitude, longitude])
  @@index([parentId])
  @@index([isCurated])
}

/// Seeded taxonomy (src/lib/genres.seed.ts). Replaces matching the free-text
/// Band.genre string with `contains`.
model Genre {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  /// Spellings users actually type: ["shoe gaze", "nugaze"]. Queried with
  /// `{ aliases: { has: token } }` -- fine as a seq scan at ~150 rows.
  aliases   String[]    @default([])
  parentId  String?
  parent    Genre?      @relation("GenreParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children  Genre[]     @relation("GenreParent")
  sortOrder Int         @default(100)
  isActive  Boolean     @default(true)
  bands     BandGenre[]
  createdAt DateTime    @default(now())

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model BandGenre {
  id        String   @id @default(cuid())
  bandId    String
  band      Band     @relation(fields: [bandId], references: [id])
  genreId   String
  genre     Genre    @relation(fields: [genreId], references: [id])
  /// 0 = primary genre.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bandId, genreId])
  @@index([bandId])
  /// Load-bearing: the unique above only serves bandId-leading lookups, and the
  /// hot "Houston Shoegaze" query filters on genreId first.
  @@index([genreId])
}

model UserCraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  craft     Craft
  forHire   Boolean  @default(false)
  headline  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, craft])
  @@index([userId])
  /// Serves "photographers for hire", intersected against User.sceneId.
  @@index([craft, forHire])
}

enum ListingKind {
  RENT
  SALE
}

enum ListingStatus {
  ACTIVE
  CLAIMED
  CLOSED
}

model Listing {
  id                String                    @id @default(cuid())
  title             String
  description       String
  category          String?
  kind              ListingKind               @default(RENT)
  price             Float?
  openToTrades      Boolean                   @default(false)
  status            ListingStatus             @default(ACTIVE)
  coverUrl          String?

  city              String
  state             String?
  country           String?
  latitude          Float?
  longitude         Float?

  createdByUserId   String?
  createdByUser     User?                     @relation("UserListings", fields: [createdByUserId], references: [id])
  createdByBandId   String?
  createdByBand     Band?                     @relation("BandListings", fields: [createdByBandId], references: [id])
  createdByVenueId  String?
  createdByVenue    Venue?                    @relation("VenueListings", fields: [createdByVenueId], references: [id])

  media             ListingMedia[]
  messages          Message[]                 @relation("ListingMessages")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  @@index([city, state])
  @@index([createdByUserId])
  @@index([createdByBandId])
  @@index([createdByVenueId])
  @@index([latitude, longitude])
}

model ListingMedia {
  id                String                    @id @default(cuid())
  listing           Listing                   @relation(fields: [listingId], references: [id])
  listingId         String
  url               String
  type              MediaType                 @default(PHOTO)
  position          Int                       @default(0)
  uploaderUserId    String
  createdAt         DateTime                  @default(now())
  deletedAt         DateTime?

  @@index([listingId])
}

// A profile-owned piece of media (photo/video). May optionally be linked to a
// Show — adding media to a show creates a linked Post on the contributor's
// profile. Supports Instagram-style captions, comments, and likes.
model Post {
  id              String        @id @default(cuid())
  url             String
  type            MediaType     @default(PHOTO)
  caption         String?

  // The logged-in user who uploaded (for authorization).
  uploaderUserId  String

  // Owner profile (exactly one set) — mirrors the Listing createdBy triplet.
  ownerUserId     String?
  ownerUser       User?         @relation("UserPosts", fields: [ownerUserId], references: [id])
  ownerBandId     String?
  ownerBand       Band?         @relation("BandPosts", fields: [ownerBandId], references: [id])
  ownerVenueId    String?
  ownerVenue      Venue?        @relation("VenuePosts", fields: [ownerVenueId], references: [id])

  // Optional link to a show whose gallery this post appears in.
  showId          String?
  show            Show?         @relation(fields: [showId], references: [id])

  /// Stamped at creation: the linked show's scene, else the owner's. Explore
  /// ranks local posts off it; deriving it at read time would be a four-way
  /// join on every feed load.
  sceneId         String?
  scene           Scene?        @relation(fields: [sceneId], references: [id])

  comments        PostComment[]
  likes           PostLike[]

  createdAt       DateTime      @default(now())
  deletedAt       DateTime?

  @@index([ownerUserId])
  @@index([ownerBandId])
  @@index([ownerVenueId])
  @@index([showId])
  @@index([sceneId, createdAt])
}

model PostComment {
  id               String    @id @default(cuid())
  post             Post      @relation(fields: [postId], references: [id])
  postId           String
  text             String

  // The logged-in user who commented (for authorization).
  commenterUserId  String

  // Author profile (exactly one set).
  authorUserId     String?
  authorUser       User?     @relation("UserPostComments", fields: [authorUserId], references: [id])
  authorBandId     String?
  authorBand       Band?     @relation("BandPostComments", fields: [authorBandId], references: [id])
  authorVenueId    String?
  authorVenue      Venue?    @relation("VenuePostComments", fields: [authorVenueId], references: [id])

  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([postId])
}

model PostLike {
  id         String   @id @default(cuid())
  post       Post     @relation(fields: [postId], references: [id])
  postId     String
  likerType  String
  likerId    String
  createdAt  DateTime @default(now())

  @@unique([postId, likerType, likerId])
  @@index([postId])
}