// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}


enum Role {
  USER
  ADMIN
}

enum BandRole {
  MANAGER
  MEMBER
}

enum VenueRole {
  MANAGER
  REPRESENTATIVE
}

enum ShowStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ShowRole {
  HEADLINER
  SUPPORT
}

model User {
  id                String                    @id @default(cuid())
  username          String                    @unique
  name              String
  email             String                    @unique
  password          String
  role              Role
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  bandMemberships   BandMember[]
  venueReps         VenueRepresentative[]
  isPromoter        Boolean                   @default(false)
  messages          Message[]
  conversations     ConversationParticipant[]
  bandInvites       BandInvite[]
  venueInvites      VenueInvite[]
  showsCreated      Show[]                    @relation("showCreatedByUser")
  rentalItems       RentalItem[]
  @@index([role])
}

model Band {
  id                String                    @id @default(cuid())
  name              String
  genre             String?
  city              String?
  state             String?
  country           String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  members           BandMember[]
  shows             ShowBand[]
  showsCreated      Show[]                    @relation("showCreatedByBand")
  toursCreated      Tour[]                    @relation("tourCreatedByBand")
  tours             BandTour[]        
  invites           BandInvite[]
  showInvites       ShowInvite[]
  tourInvites       TourInvite[]
}

model BandMember {
  id                String                    @id @default(cuid())
  user              User                      @relation(fields: [userId], references: [id])
  userId            String                    
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  role              BandRole                  @default(MEMBER)
  
  @@unique([userId, bandId])
  @@index([bandId])
  @@index([userId])
}

model BandTour {
  id                String                    @id @default(cuid())

  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String 
  tour              Tour                      @relation(fields: [tourId], references: [id])
  tourId            String

  @@unique([bandId, tourId])
}

model BandInvite {
  id                String                    @id @default(cuid())
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  user              User                      @relation(fields: [userId], references: [id])
  userId            String
  status            InviteStatus              @default(PENDING)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([bandId, userId])
}

model Venue {
  id                String                    @id @default(cuid())
  name              String
  city              String 
  state             String
  country           String
  latitude          Float?
  longitude         Float?
  capacity          Int?
  contactEmail      String?
  representatives   VenueRepresentative[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  shows             Show[]   
  showInvites       ShowInvite[] 
  blocks            VenueBlock[]   
  invites           VenueInvite[]

  @@index([city])
  @@index([capacity]) 
  @@index([latitude, longitude]) 
}

model VenueRepresentative {
  id                String                    @id @default(cuid())
  user              User                      @relation(fields: [userId], references: [id])
  userId            String                    
  venue             Venue                     @relation(fields: [venueId], references: [id])
  venueId           String
  role              VenueRole                 @default(REPRESENTATIVE)
  
  @@unique([userId, venueId])
  @@index([venueId])
  @@index([userId])
}

model VenueInvite {
  id                String                    @id @default(cuid())
  venue             Venue                     @relation(fields: [venueId], references: [id])
  venueId           String
  user              User                      @relation(fields: [userId], references: [id])
  userId            String
  status            InviteStatus              @default(PENDING)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  
  @@index([venueId, userId])
}

model Tour {
  id                String                    @id @default(cuid())
  name              String                    
  startDate         DateTime?
  endDate           DateTime?
  
  bands             BandTour[]
  shows             Show[]

  tourInvites       TourInvite[]

  createdByBandId   String?
  createdByBand     Band?                     @relation("tourCreatedByBand", fields: [createdByBandId], references: [id])

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
}

model TourInvite {
  id                String                    @id @default(cuid())
  tourId            String
  bandId            String
  status            InviteStatus              @default(PENDING)

  tour              Tour                      @relation(fields: [tourId], references: [id])
  band              Band                      @relation(fields: [bandId], references: [id])

  createdAt         DateTime                  @default(now())

  @@index([tourId, bandId])
}

model Show {
  id                String                    @id @default(cuid())
  date              DateTime
  city              String
  state             String
  country           String
  status            ShowStatus                @default(PENDING)
  notes             String?

  tour              Tour?                     @relation(fields: [tourId], references: [id])
  tourId            String?

  venue             Venue?                    @relation(fields: [venueId], references: [id])
  venueId           String?

  venueName         String?
  venueAddress      String?

  bands             ShowBand[]
  showInvites       ShowInvite[]

  startTime         DateTime?
  endTime           DateTime?

  createdByBandId   String?
  createdByBand     Band?                     @relation("showCreatedByBand", fields: [createdByBandId], references: [id])

  createdByUserId   String?
  createdByUser     User?                     @relation("showCreatedByUser", fields: [createdByUserId], references: [id])

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  @@index([tourId])
  @@index([venueId])
  @@index([city])
  @@index([date])
  @@index([status])
}

model VenueBlock {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])

  startTime DateTime
  endTime   DateTime
  reason    String?
}

model ShowBand {
  id                String                    @id @default(cuid())
  band              Band                      @relation(fields: [bandId], references: [id])
  bandId            String
  show              Show                      @relation(fields: [showId], references: [id])
  showId            String
  role              ShowRole?

  @@unique([bandId, showId])
}

model ShowInvite {
  id                String                    @id @default(cuid())
  showId            String
  bandId            String?
  venueId           String?
  status            InviteStatus              @default(PENDING)

  show              Show                      @relation(fields: [showId], references: [id])
  band              Band?                     @relation(fields: [bandId], references: [id])
  venue             Venue?                    @relation(fields: [venueId], references: [id])

  createdAt         DateTime                  @default(now())

  @@index([showId, bandId, venueId])
}

model Conversation {
  id                String                    @id @default(cuid())
  name              String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  participants      ConversationParticipant[]
  messages          Message[]
}

model ConversationParticipant {
  id                String                    @id @default(cuid())
  user              User                      @relation(fields: [userId], references: [id])
  userId            String
  conversation      Conversation              @relation(fields: [conversationId], references: [id])
  conversationId    String 

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id                String                    @id @default(cuid())
  content           String 
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  sender            User?                     @relation(fields: [senderId], references: [id])
  senderId          String?
  conversation      Conversation              @relation(fields: [conversationId], references: [id])
  conversationId    String  
  

  @@index([senderId])
  @@index([conversationId])
  @@index([createdAt])
}

model RentalItem {
  id                String                    @id @default(cuid())
  title             String 
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?
  description       String 
  pricePerDay       Float 
  city              String 
  latitude          Float?
  longitude         Float?
  owner             User                      @relation(fields: [ownerId], references: [id])
  ownerId           String

  @@index([city])
  @@index([ownerId])
  @@index([pricePerDay])
  @@index([latitude, longitude])
}