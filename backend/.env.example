# Copy to .env and fill in real values. Never commit .env.
# Postgres connection string for the dev database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/backline"

# Signing key for auth tokens. Must be >= 32 chars in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# Token lifetime, e.g. 7d, 24h, 30m.
JWT_EXPIRES_IN="7d"

# Optional: server port (defaults to 3000).
# PORT=3000

# Used by docker-compose.yml to provision the local Postgres container.
POSTGRES_USER="backline"
POSTGRES_PASSWORD="replace-me"
POSTGRES_DB="backline"
